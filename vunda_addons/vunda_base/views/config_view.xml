
<odoo>
    <record id="view_config_settings_vunda_base" model="ir.ui.view">
        <field name="name">res.config.settings.vunda.base</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">
                <div class="app_settings_block" data-string="Configurações Vunda Base" string="Configurações Vunda Base">
                    <h2>Configuração Fiscal</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6">
                            <field name="sistema_nome"/>
                            <field name="sistema_serie_fiscal"/>
                            <field name="sistema_identificacao"/>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
